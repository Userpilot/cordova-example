<?xml version='1.0' encoding='utf-8'?>
<widget id="com.userpilot.cordovasample" version="1.3.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>UserpilotSample</name>
    <description>Userpilot Sample App</description>
    <author email="dev@userpilot.com" href="https://userpilot.com">
        Userpilot
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- Deep Links Configuration for cordova-plugin-deeplinks -->
    <universal-links>
        <host name="sdk" scheme="userpilot-APP_TOKEN" event="deeplink" />
    </universal-links>
    
    <!-- iOS Platform Configuration -->
    <platform name="ios">
        <hook type="after_prepare" src="scripts/configure-ios-project.js" />
        <hook type="before_compile" src="scripts/configure-ios-project.js" />

        <!-- The deeplinks plugin references this file in App/Resources on Cordova iOS 8. -->
        <resource-file src="resources/ios/UserpilotSample.entitlements" target="UserpilotSample.entitlements" />

        <!-- Set minimum iOS deployment target to 13.0 -->
        <preference name="deployment-target" value="13.0" />
        <preference name="target-device" value="universal" />
        
        <!-- Swift version configuration -->
        <preference name="SwiftVersion" value="5.0" />
        
        <!-- Build settings -->
        <config-file target="*-Info.plist" parent="CFBundleVersion">
            <string>1</string>
        </config-file>
        
        <!-- Fix for various iOS build issues -->
        <preference name="WKWebViewOnly" value="true" />
        <preference name="CordovaWebViewEngine" value="CDVWKWebViewEngine" />
        
        <!-- Build configuration -->
        <config-file target="build.xcconfig" parent="IPHONEOS_DEPLOYMENT_TARGET">
            <string>13.0</string>
        </config-file>
        
        <config-file target="build.xcconfig" parent="SWIFT_VERSION">
            <string>5.0</string>
        </config-file>
    </platform>
    
    <!-- Android Platform Configuration -->
    <platform name="android">
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <preference name="GradlePluginKotlinVersion" value="1.9.0" />

        <preference name="android-minSdkVersion" value="23" />
        <preference name="android-compileSdkVersion" value="36" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="AndroidGradlePluginVersion" value="8.9.1" />
        <preference name="GradlePluginGoogleServicesEnabled" value="true" />
        <preference name="GradlePluginGoogleServicesVersion" value="4.4.2" />

        <!-- Userpilot push notifications. The SDK's messaging service has to be
             declared by the app; kept here rather than edited into the generated
             AndroidManifest so `cordova prepare` cannot drop it. -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service android:exported="false" android:name="com.userpilot.pushNotifications.UserpilotFirebaseMessagingService">
                <intent-filter>
                    <action android:name="com.google.firebase.MESSAGING_EVENT" />
                </intent-filter>
            </service>
        </config-file>

        <!-- The sample's own scheme, for links that are not Userpilot's. -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="userpilotcordovasample" />
            </intent-filter>
        </config-file>
    </platform>
</widget>
