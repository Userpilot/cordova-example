.DS_Store

# Generated by package manager
node_modules/

# Generated by Cordova. The native projects are tracked so the app builds from
# a fresh clone — only what a build produces is ignored, the same split the
# native SDK repos use for their sample apps.
platforms/**/build/
platforms/**/.build/
platforms/**/.swiftpm/
platforms/**/DerivedData/
platforms/ios/Pods/
platforms/ios/*.xcarchive/
platforms/ios/**/xcuserdata/
platforms/android/.gradle/
platforms/android/local.properties
platforms/android/**/*.iml
plugins/**/node_modules/
plugins/**/.git/

# The Userpilot plugin is installed from its own repo with
# `npm run add:userpilot:local`, never committed here — a second copy in this
# repo would go stale the moment the plugin changes.
plugins/@userpilot/
platforms/ios/App/Plugins/@userpilot/
platforms/android/@userpilot/
platforms/android/app/src/main/java/com/userpilot/sdk/
platforms/**/plugins/@userpilot/
*.apk
*.ipa
*.dSYM
*.hmap

# AI agent tooling (local while evaluating — not tracked)
# Keeps files on disk across branch switches; use git rm --cached if they were previously tracked.
.agents/
.claude/
.cursor/
AGENTS.md
CLAUDE.md

# Locally generated agent plans — not project documentation
plan/

# Local GitHub Actions cleanup helper and audit records
/scripts/cleanup-github-actions.py
/.local/github-actions-cleanup/

# Firebase config carries a real project id and API key — each tester supplies
# their own from the Firebase console (Android push does not build without it).
platforms/android/app/google-services.json
