{
  "name": "com.userpilot.cordovasample",
  "displayName": "UserpilotSample",
  "version": "1.3.0",
  "description": "Userpilot Cordova Plugin Sample App",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cordova:platform:add": "cordova platform add android ios",
    "cordova:platform:remove": "cordova platform remove android ios",
    "clean": "cordova clean",
    "prepare": "cordova prepare",
    "build": "cordova build",
    "run:android": "cordova run android",
    "run:ios": "cordova run ios",
    "run:ios:device": "cordova build ios --device && node scripts/deploy-ios-device.js",
    "build:android": "cordova build android",
    "build:ios": "cordova build ios",
    "remove:userpilot": "cordova plugin remove @userpilot/cordova --variable DEPLOYMENT-TARGET=13.0",
    "add:userpilot": "cordova plugin add @userpilot/cordova --variable DEPLOYMENT-TARGET=13.0",
    "add:userpilot:local": "cordova plugin add ../cordova-plugin --variable DEPLOYMENT-TARGET=13.0"
  },
  "keywords": [
    "ecosystem:cordova, userpilot"
  ],
  "author": "Userpilot",
  "license": "Apache-2.0",
  "devDependencies": {
    "@userpilot/cordova": "file:../cordova-plugin",
    "cordova-android": "^14.0.1",
    "cordova-ios": "^8.1.0",
    "cordova-plugin-customurlscheme": "^5.0.2",
    "cordova-plugin-deeplinks": "^1.1.1",
    "shelljs": "^0.10.0"
  },
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-deeplinks": {
        "URL_SCHEME": "userpilot-APP_TOKEN",
        "DEEPLINK_HOST": "sdk",
        "ANDROID_PATH_PREFIX": "/"
      },
      "cordova-plugin-customurlscheme": {
        "URL_SCHEME": "userpilot-APP_TOKEN"
      },
      "@userpilot/cordova": {
        "DEPLOYMENT-TARGET": "13.0"
      }
    }
  }
}
