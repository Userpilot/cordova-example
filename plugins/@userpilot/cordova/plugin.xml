<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="@userpilot/cordova"
    version="1.3.0">

  <name>Cordova Userpilot Plugin</name>
  <description>Cordova Plugin for the native Userpilot SDKs on Android and iOS</description>
  <license>MIT</license>
  <keywords>cordova, userpilot, tracking, analytics, android, ios</keywords>

  <engines>
    <engine name="cordova-android" version=">=14.0.0" />
    <engine name="cordova-ios" version=">=8.0.0" />
  </engines>

  <!-- Android Configuration -->
  <platform name="android">
    <js-module src="www/userpilot.js" name="Userpilot">
      <clobbers target="userpilot" />
    </js-module>

    <!-- Auto-capture engine modules (internal; required by userpilot.js) -->
    <js-module src="www/autocapture/constants.js" name="AutoCaptureConstants" />
    <js-module src="www/autocapture/config.js" name="AutoCaptureConfig" />
    <js-module src="www/autocapture/interaction-type.js" name="AutoCaptureInteractionType" />
    <js-module src="www/autocapture/util/logger.js" name="AutoCaptureLogger" />
    <js-module src="www/autocapture/util/guarded-run.js" name="AutoCaptureGuardedRun" />
    <js-module src="www/autocapture/util/event-suppressor.js" name="AutoCaptureEventSuppressor" />
    <js-module src="www/autocapture/dom/redactor.js" name="AutoCaptureRedactor" />
    <js-module src="www/autocapture/dom/governance.js" name="AutoCaptureGovernance" />
    <js-module src="www/autocapture/dom/element-classifier.js" name="AutoCaptureElementClassifier" />
    <js-module src="www/autocapture/dom/element-inspector.js" name="AutoCaptureElementInspector" />
    <js-module src="www/autocapture/dom/event-target.js" name="AutoCaptureEventTarget" />
    <js-module src="www/autocapture/dom/interaction-observer.js" name="AutoCaptureInteractionObserver" />
    <js-module src="www/autocapture/screen/route-tracker.js" name="AutoCaptureRouteTracker" />
    <js-module src="www/autocapture/screen-name-tracker.js" name="AutoCaptureScreenNameTracker" />
    <js-module src="www/autocapture/coordinator.js" name="AutoCaptureCoordinator" />
    <js-module src="www/autocapture/bridge.js" name="AutoCaptureBridge" />
    <js-module src="www/autocapture/engine.js" name="AutoCaptureEngine" />

    <config-file target="res/xml/config.xml" parent="/*">
      <preference name="GradlePluginKotlinEnabled" value="true" />
      <feature name="UserpilotCordovaPlugin">
        <param name="android-package" value="com.userpilot.sdk.cordova.plugin.UserpilotCordovaPlugin" />
        <!-- Load at startup so the plugin exists when a launch deep link arrives:
             Cordova delivers that link once, before any JS has run. -->
        <param name="onload" value="true" />
      </feature>
    </config-file>

    <source-file src="src/android/UserpilotCordovaPlugin.kt" target-dir="java/com/userpilot/sdk/cordova/plugin" />
    <framework src="src/android/UserpilotPlugin.gradle" custom="true" type="gradleReference" />

    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    </config-file>
  </platform>

  <!-- iOS Configuration -->
  <platform name="ios">
    <preference name="deployment-target" value="13.0" />
    
    <js-module src="www/userpilot.js" name="Userpilot">
      <clobbers target="userpilot" />
    </js-module>

    <!-- Auto-capture engine modules (internal; required by userpilot.js) -->
    <js-module src="www/autocapture/constants.js" name="AutoCaptureConstants" />
    <js-module src="www/autocapture/config.js" name="AutoCaptureConfig" />
    <js-module src="www/autocapture/interaction-type.js" name="AutoCaptureInteractionType" />
    <js-module src="www/autocapture/util/logger.js" name="AutoCaptureLogger" />
    <js-module src="www/autocapture/util/guarded-run.js" name="AutoCaptureGuardedRun" />
    <js-module src="www/autocapture/util/event-suppressor.js" name="AutoCaptureEventSuppressor" />
    <js-module src="www/autocapture/dom/redactor.js" name="AutoCaptureRedactor" />
    <js-module src="www/autocapture/dom/governance.js" name="AutoCaptureGovernance" />
    <js-module src="www/autocapture/dom/element-classifier.js" name="AutoCaptureElementClassifier" />
    <js-module src="www/autocapture/dom/element-inspector.js" name="AutoCaptureElementInspector" />
    <js-module src="www/autocapture/dom/event-target.js" name="AutoCaptureEventTarget" />
    <js-module src="www/autocapture/dom/interaction-observer.js" name="AutoCaptureInteractionObserver" />
    <js-module src="www/autocapture/screen/route-tracker.js" name="AutoCaptureRouteTracker" />
    <js-module src="www/autocapture/screen-name-tracker.js" name="AutoCaptureScreenNameTracker" />
    <js-module src="www/autocapture/coordinator.js" name="AutoCaptureCoordinator" />
    <js-module src="www/autocapture/bridge.js" name="AutoCaptureBridge" />
    <js-module src="www/autocapture/engine.js" name="AutoCaptureEngine" />

    <config-file parent="/*" target="config.xml">
      <feature name="UserpilotCordovaPlugin">
        <param name="ios-package" value="UserpilotCordovaPlugin" />
        <!-- Load at startup so the plugin exists when CDVPluginHandleOpenURLNotification
             is posted for a launch deep link, before any JS has run. -->
        <param name="onload" value="true" />
      </feature>
    </config-file>

    <source-file src="src/ios/UserpilotCordovaPlugin.swift" target-dir="common" />

    <config-file parent="aps-environment" target="*/Entitlements-Debug.plist">
      <string>development</string>
    </config-file>
    <config-file parent="aps-environment" target="*/Entitlements-Release.plist">
      <string>production</string>
    </config-file>

    <!-- Add bridging header -->
    <header-file src="src/ios/UserpilotCordovaPlugin-Bridging-Header.h" />
    
    <!-- Ensure Swift support -->
    <config-file target="build.xcconfig" parent="SWIFT_OBJC_BRIDGING_HEADER">
        <string>$(PROJECT_DIR)/$(PROJECT_NAME)/Plugins/UserpilotCordovaPlugin-Bridging-Header.h</string>
    </config-file>
    
    <!-- Your existing podspec and other config -->
    <podspec>
      <config>
        <source url="https://cdn.cocoapods.org/" />
      </config>
      <pods use-frameworks="true">
        <pod name="Userpilot" git="https://github.com/Userpilot/ios-sdk.git" tag="1.4.0" />
      </pods>
    </podspec>
</platform>

</plugin>
